{
  "manifest_version": 3,
  "name": "Magpiary",
  "description": "Save the page you are on, or one post from a feed, to your Magpiary library on this Mac. Nothing leaves your Mac.",
  "version": "0.1.3",
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Save to Magpiary", "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "contextMenus", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" }, "description": "Open the Magpiary panel" },
    "pick": { "suggested_key": { "default": "Ctrl+Shift+P", "mac": "Command+Shift+P" }, "description": "Pick a post on this page" }
  }
}
